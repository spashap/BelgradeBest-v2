---
// On-page topic index ("On this page"), built from the article's H2 headings
// (Astro adds id anchors, so heading.slug matches the in-page #anchor).
// Renders nothing unless there are at least 3 sections.
//
// It used to paginate into horizontal slides of 10 with prev/next arrows. That
// was removed on 2026-09-13: an index exists to reveal what is on the page, and
// hiding sections 11+ behind an arrow does the opposite. Eleven articles were
// affected — `eating-and-drinking-in-belgrade` has 18 sections, so 8 of them
// were invisible in its own contents list. All items now render in one list;
// the two-column desktop layout does the shortening instead.
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings?: Heading[];
  lang?: "en" | "de";
}
const { headings = [], lang = "en" } = Astro.props;
const items = headings.filter((h) => h.depth === 2 && h.text && h.slug);
const label = lang === "de" ? "Auf dieser Seite" : "On this page";
---
{
  items.length >= 3 ? (
    <nav class="c-toc" aria-label={label}>
      <div class="c-toc__head">
        <p class="c-toc__title">{label}</p>
      </div>
      <ol class="c-toc__list">
        {items.map((h) => (
          <li>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  ) : null
}
