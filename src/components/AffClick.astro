---
// Affiliate measurement: one tiny inline script, emitted only on pages that
// actually render an affiliate block (and run only once per page). Two GA4
// events through the gtag the site already loads (no script file, request or
// cookie of its own):
//   aff_click_<partner>  a click on a partner link (partner = event NAME)
//   aff_view             a block scrolled at least half into view, once per
//                        block per page load (the denominator for click rate)
// Both use only built-in dimensions (pagePath etc.) in the admin reports.
// Where GA4 is absent (dev) or blocked, it does nothing.
---
<script is:inline>
  (function () {
    if (window.__bbAff) return;
    window.__bbAff = 1;
    document.addEventListener("click", function (e) {
      var a = e.target && e.target.closest ? e.target.closest("a[data-aff]") : null;
      if (!a || typeof window.gtag !== "function") return;
      window.gtag("event", a.getAttribute("data-aff"), {
        placement: a.getAttribute("data-aff-placement") || "",
        link_domain: a.hostname,
        transport_type: "beacon",
      });
    });
    if (!("IntersectionObserver" in window)) return;
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        if (!en.isIntersecting || typeof window.gtag !== "function") return;
        io.unobserve(en.target);
        window.gtag("event", "aff_view", { block: en.target.getAttribute("data-aff-block") || "" });
      });
    }, { threshold: 0.5 });
    var start = function () {
      document.querySelectorAll("[data-aff-block]").forEach(function (b) { io.observe(b); });
    };
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", start);
    else start();
  })();
</script>
