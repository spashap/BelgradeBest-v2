---
// "Book ahead" travel-partner block (airport transfers, flights, eSIM), the
// sibling of StayLinks for non-hotel affiliates. Renders one CTA per key in
// the article frontmatter `partnerTargets` (placements: src/data/
// partner-links.json; switches + tracked links: src/data/affiliates.json,
// edited from /admin/affiliates). Invisible while the partner is off. Same
// rel="sponsored nofollow" + disclosure rules as StayLinks.
import data from "../data/partner-links.json";
import AffClick from "./AffClick.astro";
import { travelLinks, clickEvent } from "../lib/affiliates";

interface Props {
  targets?: string[];
}
const { targets = [] } = Astro.props;
const items = travelLinks(targets);
---
{
  items.length > 0 ? (
    <aside class="c-staylinks" aria-label={data.heading}>
      <p class="c-staylinks__title">{data.heading}</p>
      <ul class="c-staylinks__list">
        {items.map((x) => (
          <li>
            <a href={x.href} target="_blank" rel="sponsored nofollow noopener" data-aff={clickEvent(x.partner)} data-aff-placement={x.placement}>
              {x.label}
            </a>
          </li>
        ))}
      </ul>
      <p class="c-staylinks__disc">
        {data.disclosure} <a href={data.disclosureHref}>How we make money</a>.
      </p>
      <AffClick />
    </aside>
  ) : null
}
