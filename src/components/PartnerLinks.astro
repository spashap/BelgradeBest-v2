---
// "Book ahead" travel-partner block (airport transfers, flights, eSIM), the
// sibling of StayLinks for non-hotel affiliates. Renders one CTA per key in
// the article frontmatter `partnerTargets` (placements: src/data/
// partner-links.json; switches + tracked links: src/data/affiliates.json,
// edited from /admin/affiliates). Invisible while the partner is off. Same
// rel="sponsored nofollow" + disclosure rules as StayLinks; `lang` picks the
// translated chrome + labels for the /de/ and /sk/ pilots.
import data from "../data/partner-links.json";
import AffClick from "./AffClick.astro";
import { travelLinks, travelChrome, clickEvent } from "../lib/affiliates";

interface Props {
  targets?: string[];
  lang?: string;
  // Article slug: goes into the CJ sub-ID so earnings trace to the page.
  page?: string;
}
const { targets = [], lang = "en", page } = Astro.props;
const chrome = travelChrome(lang);
const items = travelLinks(targets, lang, page);
---
{
  items.length > 0 ? (
    <aside class="c-staylinks" aria-label={chrome.heading} data-aff-block="travel">
      <p class="c-staylinks__title">{chrome.heading}</p>
      <ul class="c-staylinks__list">
        {items.map((x) => (
          <li>
            <a href={x.href} target="_blank" rel="sponsored nofollow noopener" data-aff={clickEvent(x.partner)} data-aff-placement={x.placement}>
              {x.label}
            </a>
          </li>
        ))}
      </ul>
      <p class="c-staylinks__disc">
        {chrome.disclosure} <a href={data.disclosureHref}>{chrome.disclosureLink}</a>.
      </p>
      <AffClick />
    </aside>
  ) : null
}
