---
// "Where to book your stay" affiliate block. Renders ONE CTA per stay-target a
// page declares (article frontmatter `stayTargets`); the areas live in
// src/data/stay-affiliates.json, the Booking.com switch + partner ID in
// src/data/affiliates.json (edited from /admin/affiliates). Invisible while the
// partner is off. Affiliate links carry rel="sponsored nofollow" (Google's
// required attribute) and sit beside a disclosure linking the "how we make
// money" page. Affiliate data never lives in article markdown.
import data from "../data/stay-affiliates.json";
import AffClick from "./AffClick.astro";
import { stayLinks, clickEvent } from "../lib/affiliates";

interface Props {
  targets?: string[];
  heading?: string;
}
const { targets = [], heading = "Where to book your stay" } = Astro.props;
const items = stayLinks(targets);
---
{
  items.length > 0 ? (
    <aside class="c-staylinks" aria-label={heading}>
      <p class="c-staylinks__title">{heading}</p>
      <ul class="c-staylinks__list">
        {items.map((x) => (
          <li>
            <a href={x.href} target="_blank" rel="sponsored nofollow noopener" data-aff={clickEvent(x.partner)} data-aff-placement={x.placement}>
              {x.label}
            </a>
          </li>
        ))}
      </ul>
      <p class="c-staylinks__disc">
        {data.disclosure} <a href={data.disclosureHref}>How we make money</a>.
      </p>
      <AffClick />
    </aside>
  ) : null
}
