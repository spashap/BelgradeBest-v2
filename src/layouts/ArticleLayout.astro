---
import { render } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import LangNote from "../components/LangNote.astro";
import Container from "../components/Container.astro";
import Placeholder from "../components/Placeholder.astro";
import ArticleHero from "../components/ArticleHero.astro";
import ArticleToc from "../components/ArticleToc.astro";
import StayLinks from "../components/StayLinks.astro";
import PartnerLinks from "../components/PartnerLinks.astro";
import InternalLinkBlock from "../components/InternalLinkBlock.astro";
import Schema from "../components/Schema.astro";
import { articleSchema, breadcrumbSchema } from "../lib/schemas";
import { SITE, CONFIG, interp } from "../lib/site";
import { clusterBySlug } from "../lib/clusters";
import { heroForPath, thumbForPath } from "../lib/hero";
import { relatedFor } from "../lib/links";
import { pageMetadata } from "../lib/metadata";
import type { Article } from "../lib/articles";
import { UI, alternates, langPath, twinLangs, fmtDate, type Lang, type TrLang } from "../lib/i18n";
import { getCollection } from "astro:content";

// Leg-agnostic T3 article template. Per-leg chrome (eyebrow, breadcrumb root,
// read-next copy, Expo-only Event schema) is derived from the cluster registry.
interface Props {
  entry: Article;
  // Language pilot (lib/i18n.ts): "de" renders the German twin of an English
  // article at /de/<leg>/<slug> — same layout, German chrome strings, German
  // read-next set, hreflang both ways. Default "en" is byte-identical to before.
  lang?: Lang;
}
const { entry, lang = "en" } = Astro.props;
// Translated = any non-English pilot language (de, sk). T = its chrome strings.
const isTr = lang !== "en";
const T = isTr ? UI[lang as TrLang] : null;
const d = entry.data;
const leg = d.leg;
const enHref = `/${leg}/${d.slug}`;
const href = langPath(lang, enHref);
const url = SITE.origin + href;
// hreflang: every translation the English article has (de/sk collections);
// a translated page is always in that set alongside its English original.
const twins = await twinLangs(enHref);
const hasTwin = twins.length > 0;

const c = clusterBySlug(leg);
const eyebrow = c?.eyebrow ?? leg;
const crumbRoot = {
  name: c?.title ?? leg,
  href: SITE.origin + langPath(lang, c?.href ?? `/${leg}`),
};
const rn = T
  ? { eyebrow: T.readNextEyebrow, title: T.readNextTitle, intro: T.readNextIntro }
  : leg === "expo-2027"
    ? CONFIG.chrome.article.readNextExpo
    : CONFIG.chrome.article.readNextEvergreen;

// Legs where the reader arrives with a task rather than to browse.
// Pages carrying the "tell us what was missing" invitation. Deliberately a
// short list: a prompt on all 55 articles is a survey nobody answers, whereas a
// prompt on the pages with real arrival decisions can surface one concrete gap.
const INVITE_FEEDBACK = new Set([
  "plan-your-trip/airport-to-city",
  "plan-your-trip/getting-around",
  "visit-belgrade/belgrade-itinerary-3-days",
]);
const PRACTICAL_LEGS = new Set(["plan-your-trip"]);
const isPractical = PRACTICAL_LEGS.has(leg);
const resolvedHero = heroForPath(enHref, d.heroAlt ?? d.heroLabel);
const heroAbs = resolvedHero ? SITE.origin + resolvedHero.src : undefined;

const meta = pageMetadata({
  title: d.title,
  description: d.description,
  path: href,
  noindex: d.noindex,
  image: resolvedHero?.src,
  imageAlt: d.heroAlt ?? resolvedHero?.alt ?? d.title,
  lang,
  alternates: hasTwin ? alternates(enHref, twins) : undefined,
});

const { Content, headings } = await render(entry);
// Translated read-next: the other pages of the same leg in that language
// (there is no translated linksTo graph; the sets are small enough to list).
const targets = isTr
  ? (await getCollection(lang as TrLang))
      .filter((e) => e.data.leg === leg && e.data.slug !== d.slug && e.data.visible !== false)
      .sort((a, b) => a.data.order - b.data.order)
      .map((e) => {
        const p = `/${e.data.leg}/${e.data.slug}`;
        const h = thumbForPath(p, e.data.heroAlt ?? e.data.heroLabel);
        return { href: langPath(lang, p), title: e.data.shortTitle, body: e.data.description, heroSrc: h?.src, heroAlt: h?.alt };
      })
  : await relatedFor(leg, d.slug);

// Human-readable freshness stamp (same source as schema dateModified).
const updatedLabel = Number.isNaN(Date.parse(d.lastUpdated)) ? null : fmtDate(d.lastUpdated, lang);

// Event JSON-LD lives on the /expo-2027 hub only (LegHubLayout) — re-declaring
// it on every expo article duplicated the Event with inconsistent images.
const schemas: object[] = [
  articleSchema({ title: d.title, description: d.description, url, dateModified: d.lastUpdated, imageUrl: heroAbs, inLanguage: lang }),
  breadcrumbSchema([
    { name: CONFIG.chrome.article.breadcrumbRoot, url: SITE.origin + (T ? T.hub : "") },
    { name: crumbRoot.name, url: crumbRoot.href },
    { name: d.shortTitle, url },
  ]),
];
// NO FAQ markup here on purpose. The `faqs` frontmatter is never rendered by
// this layout, so emitting FAQPage described content the reader could not see —
// and the two copies had already drifted apart (the airport article's FAQ gave a
// rail date its own body contradicted). Google retired FAQ rich results on
// 2026-05-07, so the markup bought nothing either. The frontmatter is kept as
// editorial source material: fold useful answers into the body when editing a
// page, then delete them. See BELGRADEBEST_CONTENT_AUDIT.md.
---
<BaseLayout meta={meta}>
  <PageIntro eyebrow={eyebrow} title={d.title} lede={d.lede} />

  {
    updatedLabel ? (
      <Container variant="article">
        <p class="c-article-meta">
          {T ? `${T.updated} ${updatedLabel}` : `Updated ${updatedLabel}`}
        </p>
      </Container>
    ) : null
  }

  {
    /* The twin-language invitation, in the language it points at. High on the
       page so a German reader sees German before scrolling, and so the German
       set gets a real anchor-text link from the English article. */
    hasTwin ? (
      <Container variant="article">
        {isTr ? (
          <LangNote to="en" href={enHref} />
        ) : (
          twins.map((l) => <LangNote to={l} href={langPath(l, enHref)} />)
        )}
      </Container>
    ) : null
  }

  {
    /* Practical pages skip the hero. On /plan-your-trip the reader has a job —
       get from the airport, pay for something, check a visa — and the image sat
       between the short answer and the section that actually does the work
       (measured: lede, then image at ~4.4KB, TOC at ~5.0KB, first section at
       ~6.2KB). The hero is still generated and still used as the OG/social card
       via `meta.image`; it just no longer delays the answer. Leisure legs keep
       it, where browsing is part of the point. */
    isPractical ? null : (
      <Container>
        {resolvedHero ? (
          <ArticleHero
            src={resolvedHero.src}
            srcset={resolvedHero.srcset}
            sizes={resolvedHero.sizes}
            alt={d.heroAlt ?? resolvedHero.alt}
          />
        ) : (
          <Placeholder ratio="21/9" label={d.heroLabel} />
        )}
      </Container>
    )
  }

  <Container variant="article">
    <div class="u-stack-lg">
      <ArticleToc headings={headings} lang={lang} />
      <article class="c-article">
        <Content />
      </article>
      {
        d.unknowns && d.unknowns.length > 0 ? (
          <aside class="c-unknowns">
            <h2>{T ? T.unknowns : "Still unknown or unconfirmed"}</h2>
            <ul>{d.unknowns.map((u: string) => <li>{u}</li>)}</ul>
          </aside>
        ) : null
      }
      {
        /* A reader who hits a gap can report it. This is the surviving form of
           the "was this useful?" idea: at ~114 real sessions per 60 days a vote
           widget could never reach a decidable sample, but ONE specific
           "you never said X" is actionable on its own. No endpoint, no scores. */
        INVITE_FEEDBACK.has(`${leg}/${d.slug}`) ? (
          <p class="c-article-meta">
            {T ? T.feedbackText : "Something wrong, out of date, or missing from this guide? "}
            <a href="/contact">
              {T ? T.feedbackLink : "Tell us what you needed"}
            </a>.
          </p>
        ) : null
      }
      <PartnerLinks targets={d.partnerTargets} />
      <StayLinks targets={d.stayTargets} />
    </div>
  </Container>

  <div class="u-stack-lg"></div>

  <InternalLinkBlock eyebrow={rn.eyebrow} title={interp(rn.title)} intro={rn.intro} targets={targets} />

  <Schema schemas={schemas} />
</BaseLayout>
