---
// T4: one layout for every listing profile — top-level (pavilion, restaurant…)
// and child (exhibitor/booth under a parent). Renders ONLY editorial fields;
// the operator-only `contact`/`outreach` fields must never appear here.
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PageIntro from "../components/PageIntro.astro";
import Container from "../components/Container.astro";
import SectionHead from "../components/SectionHead.astro";
import Note from "../components/Note.astro";
import Faq from "../components/Faq.astro";
import Schema from "../components/Schema.astro";
import { pageMetadata } from "../lib/metadata";
import { SITE, EXPO, CONFIG } from "../lib/site";
import { articleSchema, breadcrumbSchema, faqSchema } from "../lib/schemas";
import { metaTrim } from "../lib/text";
import { ogImage } from "../lib/og";
import { DE, alternates, dePath, fmtDate, type Lang } from "../lib/i18n";
import {
  listingHref,
  listingsIndexable,
  childrenOf,
  parentOf,
  SECTION,
  type Listing,
} from "../lib/listings";

interface Props {
  listing: Listing;
  // Language pilot (lib/i18n.ts): "de" renders the listing's `i18n.de` block at
  // /de/<leg>/<section>/<slug> with German chrome. Only top-level listings that
  // carry the block build in German (pages/de/…/[slug].astro). Default "en" is
  // byte-identical to before.
  lang?: Lang;
}
const { listing, lang = "en" } = Astro.props;
const isDe = lang === "de";
const de = isDe ? listing.i18n?.de : undefined;
const hasDe = !!listing.i18n?.de?.summary && !listing.parent;

const enPathname = listingHref(listing);
const path = isDe ? dePath(enPathname) : enPathname;
const url = `${SITE.origin}${path}`;
const section = SECTION[listing.leg] ?? "places";
const hubPath = `${isDe ? "/de" : ""}/${listing.leg}/${section}`;
const parent = parentOf(listing);
const children = childrenOf(listing.leg, listing.slug);
const name = de?.name ?? listing.name;
const short = de?.shortName ?? listing.shortName ?? listing.name;
const summary = de?.summary ?? listing.summary;
const L = DE.listing;

const STATUS_LABEL: Record<string, string> = {
  announced: "Plans announced",
  tender: "Tender under way",
  construction: "Under construction",
  "concept-only": "Concept reported",
};
const statusLabel = listing.status
  ? ((isDe ? L.status[listing.status] : STATUS_LABEL[listing.status]) ?? listing.status)
  : null;
const kind = isDe
  ? listing.type === "pavilion" ? L.kindPavilion : listing.type === "exhibitor" ? L.kindExhibitor : L.kindParticipant
  : listing.type === "pavilion" ? "National pavilion" : listing.type === "exhibitor" ? "Exhibitor" : "Participant";

const meta = pageMetadata({
  title: isDe ? `${name} ${L.titleSuffix}` : `${listing.name} at Expo 2027 Belgrade — theme & plans`,
  description: metaTrim(summary),
  path,
  noindex: !listingsIndexable,
  image: ogImage(`pavilion-${listing.slug}`),
  imageAlt: isDe ? `${name} ${L.imageAlt}` : `${listing.name} at Expo 2027 Belgrade — profile on BelgradeBest`,
  lang,
  alternates: hasDe ? alternates(enPathname) : undefined,
});

const crumbTrail = [
  { name: CONFIG.chrome.article.breadcrumbRoot, href: isDe ? "/de/expo-2027" : "/" },
  { name: EXPO.shortName, href: isDe ? "/de/expo-2027" : "/expo-2027" },
  { name: isDe ? L.pavilions : "Pavilions", href: hubPath },
  ...(parent ? [{ name: parent.shortName ?? parent.name, href: listingHref(parent) }] : []),
  { name: short },
];

const schemas: object[] = [
  articleSchema({
    title: isDe ? `${name} auf der Expo 2027 Belgrad` : `${listing.name} at Expo 2027 Belgrade`,
    description: metaTrim(summary),
    url,
    dateModified: listing.updated,
    inLanguage: lang,
  }),
  breadcrumbSchema(
    crumbTrail.map((c) => ({ name: c.name, url: `${SITE.origin}${c.href ?? path}` })),
  ),
];

// Expo dates from the config master (one source for the fact).
const expoDates = `${fmtDate(EXPO.startDate, lang)} – ${fmtDate(EXPO.endDate, lang)}`;

const facts = de?.facts ?? listing.blocks.facts ?? [];
const about = de?.about ?? listing.blocks.about ?? [];
const quotes = listing.blocks.quotes ?? [];
const sources = listing.links?.sources ?? [];
const faqs = de?.faqs ?? listing.faqs ?? [];
if (faqs.length > 0) schemas.push(faqSchema(faqs));
const SRC = isDe ? L.source : "[source]";
---

<BaseLayout meta={meta}>
  <Breadcrumbs crumbs={crumbTrail} />
  <PageIntro
    eyebrow={`Expo 2027 · ${kind}${statusLabel ? ` · ${statusLabel}` : ""}`}
    title={name}
    lede={summary}
  />

  <Container variant="read">
    {listing.claimed && (
      <Note tone="gold">
        {isDe ? (
          <>
            <strong>{L.managedBy(short)}</strong> {L.managedText}
          </>
        ) : (
          <>
            <strong>Managed by the {short} team.</strong> The information on this page is provided
            and kept current by the listing's own representatives; sources and editorial framing
            remain ours.
          </>
        )}
      </Note>
    )}

    {facts.length > 0 && (
      <>
        <SectionHead title={isDe ? L.atAGlance : "At a glance"} />
        <div class="c-data-table">
          <table>
            <tbody>
              {facts.map((f) => (
                <tr>
                  <th scope="row">{f.label}</th>
                  <td>
                    {f.value}
                    {f.source ? (
                      <>
                        {" "}
                        <a href={f.source} rel="nofollow noopener">
                          {SRC}
                        </a>
                      </>
                    ) : null}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )}

    {about.length > 0 && (
      <>
        <SectionHead title={isDe ? (listing.claimed ? L.aboutHead(short) : L.announcedHead) : listing.claimed ? `About ${short}` : "What's been announced"} />
        {about.map((p) => <p>{p}</p>)}
      </>
    )}

    {(listing.images ?? []).length > 0 && (
      <>
        <SectionHead title={isDe ? L.photos : "Photos"} />
        <div class="c-grid">
          {(listing.images ?? []).map((src, i) => (
            <figure>
              <img
                src={src}
                alt={`${name} — ${isDe ? L.photoAlt : "photo"} ${i + 1}`}
                loading="lazy"
                decoding="async"
                width="640"
                height="480"
                style="width:100%;height:auto;border-radius:var(--radius);border:1px solid var(--line)"
              />
            </figure>
          ))}
        </div>
      </>
    )}

    {quotes.map((q) => (
      <blockquote>
        “{q.quote}” — {q.who}
        {q.source ? (
          <>
            {" "}
            <a href={q.source} rel="nofollow noopener">
              {SRC}
            </a>
          </>
        ) : null}
      </blockquote>
    ))}

    {children.length > 0 && (
      <>
        <SectionHead
          title={isDe ? L.childrenHead : `Exhibitors & related participants`}
          intro={isDe ? L.childrenIntro(short) : `Organizations presenting under or alongside the ${short} presence — each with its own profile.`}
        />
        <ul>
          {children.map((c) => (
            <li>
              <a href={listingHref(c)}>{c.name}</a> — {c.summary.split(". ")[0]}.
            </li>
          ))}
        </ul>
      </>
    )}

    {parent && (
      <p>
        {isDe ? (
          <>{L.partOf(parent.name)} <a href={listingHref(parent)}>{parent.name}</a></>
        ) : (
          <>Part of the <a href={listingHref(parent)}>{parent.name}</a> presence at {EXPO.shortName}.</>
        )}
      </p>
    )}

    <SectionHead title={isDe ? L.whereHead(short, listing.type === "pavilion") : `Where to find the ${short} ${listing.type === "pavilion" ? "pavilion" : "presence"}`} />
    {isDe ? (
      <p>{L.whereText}</p>
    ) : (
    <p>
      National pavilions sit in the <strong>International Participant Area</strong> of the
      25-hectare Expo site at {EXPO.venue}, in the western part of Belgrade — the zone that
      becomes the city's new Belgrade Fair after the event. The site is about
      <strong> 5 km from Nikola Tesla Airport</strong> and roughly
      <strong> 13.5 km southwest of central Belgrade</strong> (official planning figures), so
      if you fly in, you land closer to the Expo grounds than to town. Exact positions within
      the zones haven't been published yet; we'll add the location when the site plan lands.
    </p>
    )}

    <SectionHead title={isDe ? L.visitingHead : "Visiting — the practical context"} />
    {isDe ? (
      <ul>
        <li>
          <strong>{L.dates}</strong> {L.datesText(expoDates, EXPO.classification)}
        </li>
        <li>
          <strong>{L.gettingThere}</strong> {L.gettingThereText}{" "}
          <a href="/de/expo-2027/getting-there">{L.gettingThereLink}</a>.
        </li>
        <li>
          <strong>{L.tickets}</strong> {L.ticketsText}{" "}
          <a href="/de/expo-2027/tickets">{L.ticketsLink}</a>.
        </li>
        <li>
          <strong>{L.stay}</strong> {L.stayText}{" "}
          <a href="/de/expo-2027/where-to-stay-for-expo">{L.stayLink}</a>.
        </li>
      </ul>
    ) : (
      <ul>
        <li>
          <strong>Dates:</strong> {expoDates} ({EXPO.classification}, 93 days). Each participating
          country also gets a National Day — that schedule isn't published yet.
        </li>
        <li>
          <strong>Getting there:</strong> Belgrade's regular city public transport is currently
          free to ride; a taxi or ride-hail app (CarGo, Yandex Go) covers the ~13.5 km from the
          centre. A new airport–Surčin railway is under construction but not yet running — the
          honest status of every route is in <a href="/expo-2027/getting-there">getting to Expo 2027</a>.
        </li>
        <li>
          <strong>Tickets:</strong> sales are scheduled to start on 15 September 2026 (per the
          printing tender), prices unannounced — what's actually known is tracked in the{" "}
          <a href="/expo-2027/tickets">Expo 2027 tickets guide</a>.
        </li>
        <li>
          <strong>Where to stay:</strong> the airport-side vs city-centre trade-off is weighed in{" "}
          <a href="/expo-2027/where-to-stay-for-expo">where to stay for Expo 2027</a>.
        </li>
      </ul>
    )}

    {faqs.length > 0 && (
      <>
        <SectionHead title={isDe ? L.faqHead(short) : `${short} at Expo 2027 — quick answers`} />
        <Faq faqs={faqs} />
      </>
    )}

    <Note>
      {isDe ? (
        <>
          <strong>{L.maintainedHead}</strong> {L.maintainedText} {L.maintainedClaim(short)}{" "}
          <a href="/for-businesses">{L.maintainedClaimLink}</a> {L.maintainedClaimTail}
        </>
      ) : (
        <>
          <strong>How this page is maintained.</strong> This profile is compiled editorially from
          the public sources listed below — we mark plans as announced or reported, never guessed.
          Represent {short}? You can <a href="/for-businesses">claim this page for free</a> and
          keep it current yourself.
        </>
      )}
    </Note>

    {sources.length > 0 && (
      <>
        <SectionHead title={isDe ? L.sources : "Sources"} />
        <ul>
          {sources.map((s) => (
            <li>
              <a href={s.url} rel="nofollow noopener">
                {s.url}
              </a>
              {s.note ? ` — ${s.note}` : ""}
            </li>
          ))}
        </ul>
      </>
    )}

    {isDe ? (
      <p>
        {L.moreOn} <a href="/expo-2027/tracker">{L.tracker}</a> ·{" "}
        <a href={hubPath}>{L.allPavilions}</a> ·{" "}
        <a href="/de/expo-2027">{L.fullGuide}</a> ·{" "}
        <a href={enPathname} hreflang="en">{L.englishVersion}</a>
      </p>
    ) : (
      <p>
        More on the Expo: <a href="/expo-2027/tracker">participant tracker</a> ·{" "}
        <a href={hubPath}>all pavilion profiles</a> ·{" "}
        <a href="/expo-2027#whos-coming">who's coming to Expo 2027</a> ·{" "}
        <a href="/expo-2027">the full Expo 2027 guide</a>
        {hasDe ? (
          <>
            {" "}· <a href={dePath(enPathname)} hreflang="de" lang="de">Dieses Profil auf Deutsch</a>
          </>
        ) : null}
      </p>
    )}
  </Container>

  <Schema schemas={schemas} />
</BaseLayout>
