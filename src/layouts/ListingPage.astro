---
// T4: one layout for every listing profile — top-level (pavilion, restaurant…)
// and child (exhibitor/booth under a parent). Renders ONLY editorial fields;
// the operator-only `contact`/`outreach` fields must never appear here.
//
// 2026-09-06 redesign (mobile-first): status + updated as chips in the intro,
// a sticky "on this page" chip row, facts as a key/value grid instead of a
// table, exhibitors + visiting guides + "explore" as link tiles instead of
// inline text-link rows, sources collapsed. Section ids are stable anchors.
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PageIntro from "../components/PageIntro.astro";
import Container from "../components/Container.astro";
import SectionHead from "../components/SectionHead.astro";
import Note from "../components/Note.astro";
import Faq from "../components/Faq.astro";
import Schema from "../components/Schema.astro";
import { pageMetadata } from "../lib/metadata";
import { SITE, EXPO, CONFIG } from "../lib/site";
import { articleSchema, breadcrumbSchema, faqSchema } from "../lib/schemas";
import { metaTrim } from "../lib/text";
import { ogImage } from "../lib/og";
import { DE, alternates, dePath, fmtDate, type Lang } from "../lib/i18n";
import {
  listingHref,
  listingsIndexable,
  childrenOf,
  parentOf,
  SECTION,
  STATUS_LABEL,
  type Listing,
} from "../lib/listings";

interface Props {
  listing: Listing;
  // Language pilot (lib/i18n.ts): "de" renders the listing's `i18n.de` block at
  // /de/<leg>/<section>/<slug> with German chrome. Only top-level listings that
  // carry the block build in German (pages/de/…/[slug].astro).
  lang?: Lang;
}
const { listing, lang = "en" } = Astro.props;
const isDe = lang === "de";
const de = isDe ? listing.i18n?.de : undefined;
const hasDe = !!listing.i18n?.de?.summary && !listing.parent;

const enPathname = listingHref(listing);
const path = isDe ? dePath(enPathname) : enPathname;
const url = `${SITE.origin}${path}`;
const section = SECTION[listing.leg] ?? "places";
const hubPath = `${isDe ? "/de" : ""}/${listing.leg}/${section}`;
const parent = parentOf(listing);
const children = childrenOf(listing.leg, listing.slug);
const name = de?.name ?? listing.name;
const short = de?.shortName ?? listing.shortName ?? listing.name;
const summary = de?.summary ?? listing.summary;
const L = DE.listing;

const statusLabel = listing.status
  ? ((isDe ? L.status[listing.status] : STATUS_LABEL[listing.status]) ?? listing.status)
  : null;
const kind = isDe
  ? listing.type === "pavilion" ? L.kindPavilion : listing.type === "exhibitor" ? L.kindExhibitor : L.kindParticipant
  : listing.type === "pavilion" ? "National pavilion" : listing.type === "exhibitor" ? "Exhibitor" : "Participant";
const childKind = (t: string) =>
  isDe ? L.childKind(t) : t.charAt(0).toUpperCase() + t.slice(1);

const meta = pageMetadata({
  title: isDe ? `${name} ${L.titleSuffix}` : `${listing.name} at Expo 2027 Belgrade — theme & plans`,
  description: metaTrim(summary),
  path,
  noindex: !listingsIndexable,
  image: ogImage(`pavilion-${listing.slug}`),
  imageAlt: isDe ? `${name} ${L.imageAlt}` : `${listing.name} at Expo 2027 Belgrade — profile on BelgradeBest`,
  lang,
  alternates: hasDe ? alternates(enPathname) : undefined,
});

const crumbTrail = [
  { name: CONFIG.chrome.article.breadcrumbRoot, href: isDe ? "/de/expo-2027" : "/" },
  { name: EXPO.shortName, href: isDe ? "/de/expo-2027" : "/expo-2027" },
  { name: isDe ? L.pavilions : "Pavilions", href: hubPath },
  ...(parent ? [{ name: parent.shortName ?? parent.name, href: listingHref(parent) }] : []),
  { name: short },
];

const schemas: object[] = [
  articleSchema({
    title: isDe ? `${name} auf der Expo 2027 Belgrad` : `${listing.name} at Expo 2027 Belgrade`,
    description: metaTrim(summary),
    url,
    dateModified: listing.updated,
    inLanguage: lang,
  }),
  breadcrumbSchema(
    crumbTrail.map((c) => ({ name: c.name, url: `${SITE.origin}${c.href ?? path}` })),
  ),
];

// Expo dates from the config master (one source for the fact).
const expoDates = `${fmtDate(EXPO.startDate, lang)} – ${fmtDate(EXPO.endDate, lang)}`;

const facts = de?.facts ?? listing.blocks.facts ?? [];
const about = de?.about ?? listing.blocks.about ?? [];
const quotes = listing.blocks.quotes ?? [];
const sources = listing.links?.sources ?? [];
const images = listing.images ?? [];
const faqs = de?.faqs ?? listing.faqs ?? [];
if (faqs.length > 0) schemas.push(faqSchema(faqs));
if (children.length > 0) {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: isDe ? L.childrenHead : `Exhibitors & related participants — ${listing.name}`,
    itemListElement: children.map((c, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: c.name,
      url: `${SITE.origin}${listingHref(c)}`,
    })),
  });
}
const SRC = isDe ? L.source : "[source]";
const firstSentence = (s: string) => {
  const i = s.indexOf(". ");
  return i > 40 ? s.slice(0, i + 1) : s;
};

// Section headings (also the sticky chip row). Only sections with content.
const H = {
  glance: isDe ? L.atAGlance : "At a glance",
  announced: isDe ? (listing.claimed ? L.aboutHead(short) : L.announcedHead) : listing.claimed ? `About ${short}` : "What's been announced",
  photos: isDe ? L.photos : "Photos",
  children: isDe ? L.childrenHead : "Exhibitors & related participants",
  visiting: isDe ? L.visitingHead : "Visiting — the practical context",
  faq: isDe ? L.faqHead(short) : `${short} at Expo 2027 — quick answers`,
  sources: isDe ? L.sources : "Sources",
};
const quickNav = [
  facts.length > 0 && { href: "#at-a-glance", label: H.glance },
  about.length > 0 && { href: "#announced", label: isDe ? "Pläne" : listing.claimed ? "About" : "Announced" },
  images.length > 0 && { href: "#photos", label: H.photos },
  children.length > 0 && { href: "#exhibitors", label: isDe ? "Aussteller" : "Exhibitors" },
  { href: "#visiting", label: isDe ? "Besuch" : "Visiting" },
  faqs.length > 0 && { href: "#faq", label: "FAQ" },
  sources.length > 0 && { href: "#sources", label: H.sources },
].filter(Boolean) as { href: string; label: string }[];

// Visiting tiles: one tap target per practical guide (no inline link rows).
const T = L.tiles;
const visitTiles = isDe
  ? [
      { href: "/de/expo-2027/getting-there", ...T.gettingThere },
      { href: "/de/expo-2027/tickets", ...T.tickets },
      { href: "/de/expo-2027/where-to-stay-for-expo", ...T.stay },
    ]
  : [
      {
        href: "/expo-2027/getting-there",
        kicker: "Getting there",
        title: "Getting to Expo 2027",
        body: "Free city transport, taxi apps, and an airport railway still under construction — the honest status of every route.",
      },
      {
        href: "/expo-2027/tickets",
        kicker: "Tickets",
        title: "Expo 2027 tickets guide",
        body: "Sales scheduled from 15 September 2026, prices unannounced — what is actually known.",
      },
      {
        href: "/expo-2027/where-to-stay-for-expo",
        kicker: "Where to stay",
        title: "Where to stay for Expo 2027",
        body: "Airport side or city centre? The trade-off, weighed.",
      },
    ];
const exploreTiles = isDe
  ? [
      { href: hubPath, ...T.directory },
      { href: "/expo-2027/tracker", ...T.tracker },
      { href: "/de/expo-2027", ...T.guide },
    ]
  : [
      {
        href: hubPath,
        kicker: "Directory",
        title: "All pavilion profiles",
        body: "Every country with announced plans — themes, teams, budgets, sourced.",
      },
      {
        href: "/expo-2027/tracker",
        kicker: "Data",
        title: "Participant tracker",
        body: "Every publicly named country, confirmation dates and the growth timeline.",
      },
      {
        href: "/expo-2027",
        kicker: "Guide",
        title: "The full Expo 2027 guide",
        body: "Dates, programme, tickets, getting there — and the rest of Belgrade.",
      },
    ];
---

<BaseLayout meta={meta}>
  <Breadcrumbs crumbs={crumbTrail} />
  <PageIntro eyebrow={`Expo 2027 · ${kind}`} title={name} lede={summary}>
    {statusLabel ? <span class={`c-status c-status--${listing.status}`}>{statusLabel}</span> : null}
    {listing.claimed ? <span class="c-status c-status--claimed">{isDe ? L.managedBy(short) : `Managed by the ${short} team`}</span> : null}
    <span>{isDe ? L.updated : "Updated"} {fmtDate(listing.updated, lang)}</span>
    {parent ? (
      <span>
        {isDe ? L.partOf(parent.name) : `Part of the ${parent.name} presence`}{" "}
        <a href={listingHref(parent)}>→</a>
      </span>
    ) : null}
  </PageIntro>

  {quickNav.length >= 3 ? (
    <nav class="c-subnav" aria-label={isDe ? L.quickNav : "On this page"}>
      <Container>
        <ul>
          {quickNav.map((a) => (
            <li><a href={a.href}>{a.label}</a></li>
          ))}
        </ul>
      </Container>
    </nav>
  ) : null}

  <Container variant="read">
    {listing.claimed && (
      <Note tone="gold">
        {isDe ? (
          <>
            <strong>{L.managedBy(short)}</strong> {L.managedText}
          </>
        ) : (
          <>
            <strong>Managed by the {short} team.</strong> The information on this page is provided
            and kept current by the listing's own representatives; sources and editorial framing
            remain ours.
          </>
        )}
      </Note>
    )}

    {facts.length > 0 && (
      <section id="at-a-glance" class="c-hash-section">
        <SectionHead title={H.glance} />
        <dl class="c-facts">
          {facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>
                {f.value}
                {f.source ? (
                  <>
                    {" "}
                    <a href={f.source} rel="nofollow noopener">
                      {SRC}
                    </a>
                  </>
                ) : null}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {about.length > 0 && (
      <section id="announced" class="c-hash-section">
        <SectionHead title={H.announced} />
        <div class="c-article">
        {about.map((p) => <p>{p}</p>)}
        {quotes.map((q) => (
          <blockquote>
            “{q.quote}” — {q.who}
            {q.source ? (
              <>
                {" "}
                <a href={q.source} rel="nofollow noopener">
                  {SRC}
                </a>
              </>
            ) : null}
          </blockquote>
        ))}
        </div>
      </section>
    )}

    {images.length > 0 && (
      <section id="photos" class="c-hash-section">
        <SectionHead title={H.photos} />
        <div class="c-grid">
          {images.map((src, i) => (
            <figure>
              <img
                src={src}
                alt={`${name} — ${isDe ? L.photoAlt : "photo"} ${i + 1}`}
                loading="lazy"
                decoding="async"
                width="640"
                height="480"
                style="width:100%;height:auto;border-radius:var(--radius);border:1px solid var(--line)"
              />
            </figure>
          ))}
        </div>
      </section>
    )}

    {children.length > 0 && (
      <section id="exhibitors" class="c-hash-section">
        <SectionHead
          title={H.children}
          intro={isDe ? L.childrenIntro(short) : `Organizations presenting under or alongside the ${short} presence — each with its own profile.`}
        />
        <div class="c-linkgrid c-linkgrid--2">
          {children.map((c) => (
            <a class="c-linkcard" href={listingHref(c)}>
              <span class="c-linkcard__kicker">{childKind(c.type)}</span>
              <span class="c-linkcard__title">{c.name}</span>
              <p>{firstSentence(c.summary)}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <section id="visiting" class="c-hash-section">
      <SectionHead
        title={H.visiting}
        intro={isDe ? L.whereHead(short, listing.type === "pavilion") : `Where to find the ${short} ${listing.type === "pavilion" ? "pavilion" : "presence"}, and the guides that cover the trip.`}
      />
      {isDe ? (
        <p class="c-article">{L.whereText}</p>
      ) : (
        <p class="c-article">
          National pavilions sit in the <strong>International Participant Area</strong> of the
          25-hectare Expo site at {EXPO.venue}, in the western part of Belgrade — the zone that
          becomes the city's new Belgrade Fair after the event. The site is about
          <strong> 5 km from Nikola Tesla Airport</strong> and roughly
          <strong> 13.5 km southwest of central Belgrade</strong> (official planning figures), so
          if you fly in, you land closer to the Expo grounds than to town. Exact positions within
          the zones haven't been published yet; we'll add the location when the site plan lands.
        </p>
      )}
      <div class="c-linkgrid c-linkgrid--2">
        <div class="c-linkcard c-linkcard--static">
          <span class="c-linkcard__kicker">{isDe ? T.dates.kicker : "Dates"}</span>
          <span class="c-linkcard__title">{expoDates}</span>
          <p>{isDe ? L.datesText(expoDates, EXPO.classification).replace(`${expoDates} `, "") : `${EXPO.classification}, 93 days. Every participating country also gets a National Day — that calendar isn't published yet.`}</p>
        </div>
        {visitTiles.map((t) => (
          <a class="c-linkcard" href={t.href}>
            <span class="c-linkcard__kicker">{t.kicker}</span>
            <span class="c-linkcard__title">{t.title}</span>
            <p>{t.body}</p>
          </a>
        ))}
      </div>
    </section>

    {faqs.length > 0 && (
      <section id="faq" class="c-hash-section">
        <SectionHead title={H.faq} />
        <Faq faqs={faqs} />
      </section>
    )}

    <Note>
      {isDe ? (
        <>
          <strong>{L.maintainedHead}</strong> {L.maintainedText} {L.maintainedClaim(short)}{" "}
          <a href="/for-businesses">{L.maintainedClaimLink}</a> {L.maintainedClaimTail}
        </>
      ) : (
        <>
          <strong>How this page is maintained.</strong> This profile is compiled editorially from
          the public sources listed below — we mark plans as announced or reported, never guessed.
          Represent {short}? You can <a href="/for-businesses">claim this page for free</a> and
          keep it current yourself.
        </>
      )}
    </Note>

    {sources.length > 0 && (
      <section id="sources" class="c-hash-section">
        <details class="c-sources">
          <summary>{isDe ? L.sourcesToggle(sources.length) : `Sources (${sources.length})`}</summary>
          <ul>
            {sources.map((s) => (
              <li>
                <a href={s.url} rel="nofollow noopener">
                  {s.url}
                </a>
                {s.note ? ` — ${s.note}` : ""}
              </li>
            ))}
          </ul>
        </details>
      </section>
    )}

    <SectionHead title={isDe ? L.exploreHead : "More on Expo 2027"} />
    <div class="c-linkgrid">
      {exploreTiles.map((t) => (
        <a class="c-linkcard" href={t.href}>
          <span class="c-linkcard__kicker">{t.kicker}</span>
          <span class="c-linkcard__title">{t.title}</span>
          <p>{t.body}</p>
        </a>
      ))}
    </div>
  </Container>

  <Schema schemas={schemas} />
</BaseLayout>
