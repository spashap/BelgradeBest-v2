---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import SectionHead from "../../components/SectionHead.astro";
import MarkdownInline from "../../components/MarkdownInline.astro";
import { clusters } from "../../lib/clusters";
import { heroForLeg, thumbForLeg } from "../../lib/hero";
import { pageMetadata } from "../../lib/metadata";
import { CONFIG } from "../../lib/site";
import { officialCount } from "../../lib/expo-participants";

// PREVIEW (2026-10-14): the "stage" homepage, built next to the live one so the
// owner decides from something seen. noindex + out of the sitemap. Same data
// as index.astro (homepage config, clusters); the new copy lives in
// site-config.json → homepage.stage. Promote = move this body into index.astro.
const H = CONFIG.homepage;
const S = H.stage;
const meta = pageMetadata({
  title: "Homepage preview",
  description: CONFIG.seo.homeDescription,
  path: "/preview/home",
  noindex: true,
});

const stageHero = heroForLeg("visit-belgrade");
const tiles = clusters.filter((c) => !c.hidden);

// Build-time fallback for the Expo countdown; the inline script refreshes it.
const DAY = 86400000;
const expoStart = Date.parse(`${CONFIG.expo.startDate}T00:00:00Z`);
const daysToExpo = Math.max(0, Math.ceil((expoStart - Date.now()) / DAY));
const runDays = Math.round((Date.parse(`${CONFIG.expo.endDate}T00:00:00Z`) - expoStart) / DAY) + 1;
---
<BaseLayout meta={meta}>
  <section class="c-stage">
    {stageHero ? (
      <img class="c-stage__bg" src={stageHero.src} srcset={stageHero.srcset} sizes="100vw" alt="" fetchpriority="high" />
    ) : null}
    <div class="u-container c-stage__inner">
      <p class="c-stage__eyebrow">{S.eyebrow}</p>
      <h1>{S.titleBefore} <em>{S.titleAccent}</em></h1>
      <p class="c-stage__lede">{S.lede}</p>
      <div class="c-stage__ctas">
        <a class="c-btn" href={S.primaryCta.href}>{S.primaryCta.label}</a>
        <a class="c-btn c-btn--ghost" href={S.secondaryCta.href}>{S.secondaryCta.label}</a>
      </div>
      <dl class="c-stage__readouts">
        <div class="c-stage__readout"><dt>Rivers</dt><dd>2<small>Sava + Danube</small></dd></div>
        <div class="c-stage__readout"><dt>City buses &amp; trams</dt><dd>Free</dd></div>
        <div class="c-stage__readout"><dt>Currency</dt><dd>RSD<small>dinar</small></dd></div>
        <div class="c-stage__readout"><dt>Ideal first visit</dt><dd>3<small>days</small></dd></div>
      </dl>
    </div>
  </section>

  <section class="u-section" id="first-visit">
    <Container>
      <SectionHead eyebrow={H.goodToKnow.eyebrow} title={H.goodToKnow.title} />
      <ol class="c-steps">
        {H.goodToKnow.items.map((it) => (
          <li class="u-reveal">
            <a class="c-step" href={it.href}>
              <span class="c-step__label">{it.label}</span>
              <span class="c-step__text">{it.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </Container>
  </section>

  <section class="c-band c-band--split">
    <Container>
      <div class="c-band__grid">
        <div>
          <p class="c-band__eyebrow">{S.expoBand.eyebrow}</p>
          <h2>{S.expoBand.titleBefore} <em>{S.expoBand.titleAccent}</em></h2>
          <p>{S.expoBand.text}</p>
          <a class="c-btn" href={S.expoBand.href}>{S.expoBand.cta}</a>
        </div>
        <div class="c-band__count">
          <div><b data-expo-days>{daysToExpo}</b><span>Days to go</span></div>
          <div><b>{officialCount}</b><span>Countries</span></div>
          <div><b>{runDays}</b><span>Days of Expo</span></div>
        </div>
      </div>
    </Container>
  </section>

  <section class="u-section">
    <Container>
      <SectionHead title={H.clustersSection.title} />
      <div class="c-bento">
        {tiles.map((c, i) => {
          const img = i === 0 ? heroForLeg(c.slug) : thumbForLeg(c.slug);
          return (
            <a class={`c-bento__tile u-reveal${i === 0 ? " c-bento__tile--lg" : ""}`} href={c.href}>
              {img ? <img src={img.src} srcset={i === 0 ? img.srcset : undefined} sizes={i === 0 ? "(max-width: 980px) 100vw, 50vw" : undefined} alt="" loading="lazy" /> : null}
              <span class="c-bento__go" aria-hidden="true">→</span>
              <span class="c-bento__kicker">{c.eyebrow}</span>
              <span class="c-bento__title">{c.title}</span>
              <span class="c-bento__text">{c.tagline}</span>
            </a>
          );
        })}
      </div>
    </Container>
  </section>

  <section class="c-band c-band--split">
    <Container>
      <div class="c-band__grid">
        <div>
          <p class="c-band__eyebrow">{S.quizBand.eyebrow}</p>
          <h2>{S.quizBand.titleBefore} <em>{S.quizBand.titleAccent}</em></h2>
          <p>{S.quizBand.text}</p>
          <a class="c-btn" href={S.quizBand.href}>{S.quizBand.cta}</a>
        </div>
        <div class="c-band__quizcard" aria-hidden="true">
          <span><b>A</b>The Drina</span>
          <span class="is-right"><b>B</b>The Sava ✓</span>
          <span><b>C</b>The Morava</span>
          <span><b>D</b>The Tisa</span>
        </div>
      </div>
    </Container>
  </section>

  <section class="u-section u-section--tight">
    <Container variant="read">
      <SectionHead title={H.ethosSection.title} intro={H.ethosSection.intro} />
      {H.ethosSection.body ? <article class="c-article"><MarkdownInline markdown={H.ethosSection.body} /></article> : null}
    </Container>
  </section>

  <script is:inline define:vars={{ start: expoStart }}>
    (function () {
      var el = document.querySelector("[data-expo-days]");
      if (el) el.textContent = String(Math.max(0, Math.ceil((start - Date.now()) / 86400000)));
    })();
  </script>
</BaseLayout>
