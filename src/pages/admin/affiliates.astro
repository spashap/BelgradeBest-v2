---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getCollection } from "astro:content";
import { readAffiliates, saveMode } from "../../lib/admin/store";
import { ga4AffiliateClicks, type AffClickRow } from "../../lib/admin/analytics";
import { clickEvent, partnerLive, partnersForTargets } from "../../lib/affiliates";
import Verdicts from "../../components/admin/Verdicts.astro";
import type { Verdict } from "../../lib/admin/insights";
import { cjEarnings } from "../../lib/admin/cj";

// Affiliate partners: per partner an ID/tracked link + an On/Off switch
// (src/data/affiliates.json via /api/admin/affiliates; a save commits and the
// Vercel rebuild switches the public blocks in ~1–2 min), where each partner
// shows on the site, and anonymous click statistics from GA4.
const file = await readAffiliates();
const partners = Object.entries(file.partners);

const sp = Astro.url.searchParams;
const err = sp.get("error");
const okKey = sp.get("ok");
const days = [7, 28, 90].includes(Number(sp.get("days"))) ? Number(sp.get("days")) : 28;
const mode = saveMode();

// Where each partner renders: visible articles (English + the /de/ and /sk/
// twins) whose frontmatter names its placements.
const withPrefix = async (c: "articles" | "de" | "sk" | "cs", prefix: string) =>
  (await getCollection(c)).filter((a) => a.data.visible !== false).map((a) => ({ a, prefix }));
const articles = [...(await withPrefix("articles", "")), ...(await withPrefix("de", "/de")), ...(await withPrefix("sk", "/sk")), ...(await withPrefix("cs", "/cs"))];
const pagesFor = new Map<string, string[]>();
for (const { a, prefix } of articles) {
  const path = `${prefix}/${a.data.leg}/${a.data.slug}`;
  for (const k of partnersForTargets(a.data.stayTargets, a.data.partnerTargets ?? [])) {
    pagesFor.set(k, [...(pagesFor.get(k) ?? []), path]);
  }
}
const allPages = [...new Set([...pagesFor.values()].flat())];

const evToKey = new Map(partners.map(([k]) => [clickEvent(k), k]));
const nameOf = (ev: string) => file.partners[evToKey.get(ev) ?? ""]?.name ?? ev;
const [stats, cj] = await Promise.all([ga4AffiliateClicks(days, [...evToKey.keys()], allPages), cjEarnings(days)]);
const usd = (n: number) => "$" + n.toFixed(2);
// Earnings per sub-ID (sid = bb-<placement>, bb-de-<placement>…).
type SidRow = { sid: string; n: number; c: number; adv: string };
const sidMap = new Map<string, SidRow>();
if (cj.configured) {
  for (const r of cj.rows) {
    const x = sidMap.get(r.sid) ?? { sid: r.sid, n: 0, c: 0, adv: r.advertiser };
    x.n += 1;
    x.c += r.commission;
    sidMap.set(r.sid, x);
  }
}
const bySid = [...sidMap.values()].sort((a, b) => b.c - a.c);
const total = (rows: AffClickRow[], ev: string) => rows.filter((r) => r.event === ev).reduce((s, r) => s + r.clicks, 0);
const top = (rows: AffClickRow[], n = 10) => rows.slice(0, n);
const pct = (a: number, b: number) => (b > 0 ? `${((a / b) * 100).toFixed(1)}%` : "–");
// ── TL;DR ──
const liveCount = partners.filter(([k]) => partnerLive(k, file.partners)).length;
const verdicts: Verdict[] = [];
verdicts.push(
  cj.configured
    ? {
        tone: cj.total > 0 ? "good" : "watch",
        label: "Earned · " + cj.days + " d (CJ)",
        value: usd(cj.total),
        line: cj.sales
          ? cj.sales + " commissions; best placement " + (bySid[0]?.sid ?? "–") + " (" + usd(bySid[0]?.c ?? 0) + ")."
          : "No commissions yet. Bookings show up in CJ days after the click; hotel stays only after check-out.",
      }
    : {
        tone: "info",
        label: "Earnings",
        value: "not linked",
        line: "CJ earnings are not connected to this page yet.",
        action: "Create a Personal Access Token at developers.cj.com and set CJ_PERSONAL_ACCESS_TOKEN in Vercel.",
      },
);
if (stats.configured) {
  const clicksAll = stats.byPartner.reduce((s, r) => s + r.clicks, 0);
  const seenAll = Object.values(stats.blockViews).reduce((s, n) => s + n, 0);
  const pvAll = allPages.reduce((s, p) => s + (stats.pageViews[p] ?? 0), 0);
  verdicts.push({
    tone: liveCount ? "info" : "bad",
    label: "Partners live",
    value: `${liveCount}/${partners.filter(([, p]) => p.available).length}`,
    line: liveCount ? `Booking boxes are on ${allPages.length} pages (${pvAll} page views in ${days} d).` : "Every partner is off: the site cannot earn anything.",
    action: liveCount ? undefined : "Paste the links below and switch partners On.",
  });
  verdicts.push({
    tone: clicksAll > 0 ? "good" : seenAll >= 50 ? "bad" : "watch",
    label: `Clicks · ${days} d`,
    value: String(clicksAll),
    line: clicksAll > 0
      ? `${clicksAll} clicks to partners from ${stats.byPartner.reduce((s, r) => s + r.users, 0)} people.`
      : seenAll >= 50 ? `Seen ${seenAll} times, never clicked.` : "Too few views to judge yet.",
    action: clicksAll === 0 && seenAll >= 50 ? "Reword the box labels or move the box higher on the strongest page." : undefined,
  });
  if (seenAll > 0) {
    const rate = clicksAll / seenAll;
    verdicts.push({
      tone: seenAll < 100 ? "watch" : rate >= 0.03 ? "good" : rate >= 0.01 ? "watch" : "bad",
      label: "Click rate (box seen → click)",
      value: `${(rate * 100).toFixed(1)}%`,
      line: `${seenAll} box views. Travel content typically converts 1–5% of box views into clicks.`,
      action: seenAll < 100 ? "Wait until 100+ box views before judging." : rate < 0.01 ? "Labels are not convincing: make them answer the reader's next step (price, time)." : undefined,
    });
  }
  const best = [...stats.byPage].sort((a, b) => b.clicks - a.clicks)[0];
  if (best) verdicts.push({ tone: "good", label: "Best page", value: String(best.clicks), line: `${best.key} earns the most clicks (${nameOf(best.event)}).`, action: "Give this page's topic more articles and a translation." });
  const dead = allPages.filter((p) => (stats.pageViews[p] ?? 0) >= 30 && !stats.byPage.some((r) => r.key === p)).sort((a, b) => (stats.pageViews[b] ?? 0) - (stats.pageViews[a] ?? 0))[0];
  if (dead) verdicts.push({ tone: "bad", label: "Traffic, no clicks", value: String(stats.pageViews[dead] ?? 0), line: `${dead} has ${stats.pageViews[dead]} views but no partner clicks.`, action: "Check the box fits what readers came for on that page." });
}

const fmt = (iso?: string | null) => (iso ? iso.slice(0, 16).replace("T", " ") + " UTC" : "never");
---
<AdminLayout title="Affiliates">
  {err ? <div class="err">{err}</div> : null}
  {okKey ? (
    <div class="ok">
      Saved {file.partners[okKey]?.name ?? okKey}.{" "}
      {mode === "github"
        ? "The site is rebuilding: the change is live in about 1–2 minutes, and this page shows the new state after that rebuild (refresh then)."
        : "Written to the local file (dev)."}
    </div>
  ) : null}
  {mode === "readonly" ? <div class="err">Saving is OFF on this deploy (no GITHUB_TOKEN). You can still see the stats.</div> : null}

  <Verdicts items={verdicts} />

  <p class="muted">
    Paste the partner's ID or tracked link, tick <b>On</b>, press <b>Save</b>. The site rebuilds itself (about 1–2 minutes) and
    the booking boxes appear on the pages listed under each partner. Untick and save to remove them. Nothing on the public pages
    changes while a partner is off. Earnings and bookings are in each partner's own dashboard; this page counts clicks.
  </p>

  {partners.map(([key, p]) => {
    const live = partnerLive(key, file.partners);
    const pages = pagesFor.get(key) ?? [];
    const clicks = stats.configured ? total(stats.byPartner, clickEvent(key)) : null;
    return (
      <div class="panel" id={key} style={p.available ? "" : "opacity:.55"}>
        <div class="row" style="justify-content:space-between">
          <div class="row">
            <b>{p.name}</b>
            {!p.available ? <span class="badge">not available</span> : live ? <span class="badge live">LIVE</span> : <span class="badge hidden">off</span>}
            {p.dashboard ? <a class="muted" href={p.dashboard} target="_blank" rel="noopener">partner dashboard ↗</a> : null}
          </div>
          <div class="muted" style="font-size:13px">
            {clicks !== null ? <span><b style="color:var(--ink)">{clicks}</b> clicks / {days} d · </span> : null}
            last change {fmt(p.changedAt)}
          </div>
        </div>
        <p class="muted" style="margin:6px 0 10px">{p.what}{p.accepted ? ` · accepted ${p.accepted}` : ""}</p>
        {p.available ? (
          <form method="post" action="/api/admin/affiliates" class="row">
            <input type="hidden" name="key" value={key} />
            <label style="flex:1;min-width:280px">
              <span class="muted" style="font-size:12px;display:block">{p.fieldLabel}</span>
              <input type="text" name="value" value={p.value} style="width:100%" autocomplete="off" spellcheck="false" />
            </label>
            <label class="row" style="gap:6px"><input type="checkbox" name="enabled" value="1" checked={p.enabled} /> On</label>
            <button type="submit">Save</button>
          </form>
        ) : (
          <p class="muted" style="margin:0">{p.unavailableReason}</p>
        )}
        <details style="margin-top:10px">
          <summary class="muted">Shows on {pages.length} page{pages.length === 1 ? "" : "s"}</summary>
          <ul style="margin:6px 0 0">
            {pages.map((pg) => <li class="slug"><a href={pg} target="_blank" rel="noopener">{pg}</a></li>)}
          </ul>
        </details>
      </div>
    );
  })}

  <h2 style="margin-top:24px">Money, last {cj.configured ? cj.days : days} days (CJ)</h2>
  {cj.configured ? (
    bySid.length ? (
      <div class="panel">
        <table>
          <tr><th>placement (sub-ID)</th><th>partner</th><th>commissions</th><th>earned</th></tr>
          {bySid.map((r) => <tr><td class="slug">{r.sid}</td><td class="muted">{r.adv}</td><td>{r.n}</td><td><b>{usd(r.c)}</b></td></tr>)}
        </table>
      </div>
    ) : (
      <div class="panel muted">No commissions in this period yet. Hotel commissions post after the guest's stay, so expect days to weeks after the first clicks.</div>
    )
  ) : (
    <div class="panel muted">{cj.reason} Until then, see earnings in CJ: Reports → Commission Detail, column <b>SID</b>.</div>
  )}

  <div class="row" style="justify-content:space-between;margin-top:24px">
    <h2 style="margin:0">Clicks, last {days} days</h2>
    <form method="get" class="row">
      <select name="days" onchange="this.form.submit()">
        {[7, 28, 90].map((d) => <option value={d} selected={d === days}>{d} days</option>)}
      </select>
      <noscript><button type="submit">Show</button></noscript>
    </form>
  </div>

  {!stats.configured ? (
    <div class="panel muted">GA4 not available: {stats.reason}</div>
  ) : stats.byPartner.length === 0 ? (
    <div class="panel muted">
      No affiliate clicks recorded in this period. Clicks are counted once a partner is LIVE; GA4 shows them after a few hours.
    </div>
  ) : (
    <>
      <div class="panel">
        <table>
          <tr><th>partner</th><th>clicks</th><th>people</th></tr>
          {stats.byPartner.map((r) => <tr><td>{nameOf(r.event)}</td><td>{r.clicks}</td><td>{r.users}</td></tr>)}
        </table>
      </div>
      <h2>Where they clicked</h2>
      <div class="panel">
        <table>
          <tr><th>page</th><th>partner</th><th>clicks</th><th>page views</th><th>box seen</th><th>click rate (of seen)</th></tr>
          {stats.byPage.map((r) => (
            <tr>
              <td class="slug">{r.key}</td><td>{nameOf(r.event)}</td><td>{r.clicks}</td>
              <td class="muted">{stats.pageViews[r.key] ?? "–"}</td><td class="muted">{stats.blockViews[r.key] ?? "–"}</td><td>{pct(r.clicks, stats.blockViews[r.key] ?? stats.pageViews[r.key] ?? 0)}</td>
            </tr>
          ))}
        </table>
      </div>
      <h2>Who clicked (anonymous)</h2>
      <div class="cards" style="grid-template-columns:repeat(auto-fill,minmax(320px,1fr))">
        {[
          ["Country", stats.byCountry],
          ["Device", stats.byDevice],
          ["Came from", stats.bySource],
        ].map(([label, rows]) => (
          <div class="panel" style="margin:0">
            <b>{label as string}</b>
            <table>
              {top(rows as AffClickRow[]).map((r) => <tr><td>{r.key}</td><td class="muted">{nameOf(r.event)}</td><td>{r.clicks}</td></tr>)}
            </table>
          </div>
        ))}
      </div>
    </>
  )}

  <p class="muted" style="margin-top:18px;font-size:13px">
    Each click sends a GA4 event named <code>aff_click_&lt;partner&gt;</code>, and each box that scrolls into view sends
    <code>aff_view</code>; no personal data is collected. Every link carries a sub-ID (<code>bb-dorcol</code>, <code>bb-de-surcin</code>,
    <code>bb-airport-transfer</code>…): in CJ open Reports → Commission Detail and look at the <b>SID</b> column to see which
    placement earned each commission. A new partner is added in code (<code>src/data/affiliates.json</code> + a placement).
  </p>
</AdminLayout>
