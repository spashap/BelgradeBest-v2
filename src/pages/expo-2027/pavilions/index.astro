---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import Container from "../../../components/Container.astro";
import Note from "../../../components/Note.astro";
import Schema from "../../../components/Schema.astro";
import { pageMetadata } from "../../../lib/metadata";
import { ogImage } from "../../../lib/og";
import { SITE, EXPO, CONFIG } from "../../../lib/site";
import { breadcrumbSchema } from "../../../lib/schemas";
import {
  listingsForLeg,
  listingHref,
  listingsIndexable,
  newestUpdated,
  STATUS_LABEL,
} from "../../../lib/listings";
import {
  participants,
  byRegion,
  regionOf,
  regionCode,
  STAGE,
  officialCount,
} from "../../../lib/expo-participants";
import { alternates } from "../../../lib/i18n";

// Pavilion ATLAS — the owner-sanctioned "tech" page of the site (globals.css
// EXPO ATLAS block, xp-*). Inverted ink deck with live readouts, a sticky
// command bar (search · status · region · sort), LED-status panels with a
// 4-stage progress track for every profiled pavilion, and dashed "slots" for
// every named country without a profile yet. Everything is in the DOM for
// crawlers; the script only filters/sorts. noindex behind listingsIndexable.
const PATH = "/expo-2027/pavilions";
const published = listingsForLeg("expo-2027");
const pavilions = published.filter((l) => l.type === "pavilion");
const orgs = published.filter((l) => l.type !== "pavilion");
const profiledNames = new Set(published.map((l) => (l.shortName ?? l.name).toLowerCase()));
const updated = newestUpdated("expo-2027");
const fmt = (d: string) =>
  new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
const firstSentence = (s: string) => {
  const i = s.indexOf(". ");
  return i > 40 ? s.slice(0, i + 1) : s;
};

// Countdown (build-time; the script re-derives it live).
const DAY = 86400000;
const startMs = Date.parse(`${EXPO.startDate}T00:00:00+02:00`);
const daysToOpen = Math.max(0, Math.ceil((startMs - Date.now()) / DAY));

// Facets.
const STATUS_ORDER = ["construction", "tender", "announced", "concept-only"];
const statusCounts = STATUS_ORDER.map((k) => ({
  key: k,
  label: STATUS_LABEL[k],
  count: pavilions.filter((p) => p.status === k).length,
})).filter((s) => s.count > 0);
const regions = byRegion();

// Panel model: region + a running code per region (EU·03), stage, counts.
const perRegion = new Map<string, number>();
const panels = pavilions.map((l) => {
  const region = regionOf(l.shortName) ?? regionOf(l.name) ?? null;
  const key = region ?? "—";
  const n = (perRegion.get(key) ?? 0) + 1;
  perRegion.set(key, n);
  return {
    l,
    region,
    code: `${regionCode(region)}·${String(n).padStart(2, "0")}`,
    stage: l.status ? (STAGE[l.status] ?? 0) : 0,
    facts: l.blocks.facts?.length ?? 0,
    faqs: l.faqs?.length ?? 0,
  };
});
const slots = participants
  .filter((p) => !profiledNames.has(p.name.toLowerCase()))
  .map((p) => ({ name: p.name, region: p.region, host: p.host === true }));

const meta = pageMetadata({
  title: "Expo 2027 pavilions — announced plans by country",
  description: `National pavilions of Expo 2027 Belgrade: which of the ${participants.length} publicly named countries have announced pavilion plans, themes and designs — ${pavilions.length} profiled and sourced.`,
  path: PATH,
  noindex: !listingsIndexable,
  image: ogImage("pavilions"),
  alternates: alternates(PATH), // hreflang ↔ /de/expo-2027/pavilions (language pilot)
});

const crumbs = [
  { name: CONFIG.chrome.article.breadcrumbRoot, href: "/" },
  { name: EXPO.shortName, href: "/expo-2027" },
  { name: "Pavilions" },
];

const schemas: object[] = [
  breadcrumbSchema([
    { name: CONFIG.chrome.article.breadcrumbRoot, url: SITE.origin },
    { name: EXPO.shortName, url: `${SITE.origin}/expo-2027` },
    { name: "Pavilions", url: `${SITE.origin}${PATH}` },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Expo 2027 Belgrade national pavilions with announced plans",
    itemListElement: published.map((l, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: l.name,
      url: `${SITE.origin}${listingHref(l)}`,
    })),
  },
];
---

<BaseLayout meta={meta}>
  <Breadcrumbs crumbs={crumbs} />

  <section class="xp-deck" data-expo-start={EXPO.startDate}>
    <Container>
      <span class="xp-deck__eyebrow">Expo 2027 · Pavilion atlas</span>
      <h1>Expo 2027 <em>national pavilions</em></h1>
      <p class="xp-deck__lede">
        Every country's pavilion plan, tracked as it lands — theme, design, budget, tender, with a
        source on each fact. Live status for {pavilions.length} profiled pavilions; a reserved slot for each
        of the {participants.length} publicly named participants. Search, filter by stage or region, sort.
      </p>
      <div class="xp-readouts">
        <div class="xp-readout">
          <div class="xp-readout__k">Opening day</div>
          <div class="xp-readout__v"><span data-countdown>{daysToOpen}</span><small>days</small></div>
        </div>
        <div class="xp-readout">
          <div class="xp-readout__k">Pavilion profiles</div>
          <div class="xp-readout__v">{pavilions.length}<small>sourced</small></div>
        </div>
        <div class="xp-readout">
          <div class="xp-readout__k">Countries named</div>
          <div class="xp-readout__v">{participants.length}<small>of {officialCount}</small></div>
        </div>
        <div class="xp-readout">
          <div class="xp-readout__k">Regions</div>
          <div class="xp-readout__v">{regions.length}<small>continents</small></div>
        </div>
      </div>
    </Container>
  </section>

  <div class="xp-bar" data-atlas>
    <Container>
      <div class="xp-bar__row">
        <input
          class="xp-search"
          type="search"
          placeholder="Search a country…"
          aria-label="Search countries"
          data-atlas-search
        />
        <div class="xp-seg" role="group" aria-label="Filter by stage">
          <button type="button" class="is-on" data-atlas-status="">All</button>
          {statusCounts.map((s) => (
            <button type="button" data-atlas-status={s.key}>{s.label} · {s.count}</button>
          ))}
        </div>
        <div class="xp-seg" role="group" aria-label="Filter by region">
          <button type="button" class="is-on" data-atlas-region="">All regions</button>
          {regions.map((r) => (
            <button type="button" data-atlas-region={r.region}>{r.region} · {r.count}</button>
          ))}
        </div>
        <div class="xp-seg" role="group" aria-label="Sort profiles">
          <button type="button" class="is-on" data-atlas-sort="name">A–Z</button>
          <button type="button" data-atlas-sort="updated">Latest</button>
        </div>
        <span class="xp-bar__count" data-atlas-count aria-live="polite"></span>
      </div>
    </Container>
  </div>

  <Container>
    <section id="profiles" class="xp-section">
      <h2 class="xp-h2">Profiled pavilions <small>{pavilions.length} live</small></h2>
      <p class="xp-sub">
        Each panel is a sourced profile: what is confirmed, what is only reported, and where the
        plan stands on the track from concept to construction.
      </p>
      <div class="xp-grid" data-atlas-grid>
        {panels.map((p, i) => (
          <a
            class="xp-panel"
            href={listingHref(p.l)}
            style={`--i:${i}`}
            data-name={p.l.name.toLowerCase()}
            data-region={p.region ?? ""}
            data-status={p.l.status ?? ""}
            data-updated={p.l.updated}
          >
            <div class="xp-panel__top">
              <span class="xp-panel__code">{p.code}</span>
              <span>{p.region ?? "Pavilion"}</span>
            </div>
            <h3>{p.l.name}</h3>
            {p.l.status ? (
              <span class={`xp-led xp-led--${p.l.status}`}>
                <i></i>
                {STATUS_LABEL[p.l.status] ?? p.l.status}
              </span>
            ) : null}
            <div class="xp-track" data-stage={p.stage} aria-label={`Stage ${p.stage} of 4`}>
              <i></i><i></i><i></i><i></i>
            </div>
            <p>{firstSentence(p.l.summary)}</p>
            <div class="xp-panel__foot">
              <span>Updated <b>{fmt(p.l.updated)}</b></span>
              <span><b>{p.facts}</b> facts · <b>{p.faqs}</b> FAQ</span>
            </div>
          </a>
        ))}
      </div>
      <div class="xp-empty" data-atlas-empty>No pavilion matches these selectors — clear one.</div>
    </section>

    {orgs.length > 0 && (
      <section id="organisations" class="xp-section">
        <h2 class="xp-h2">Organisations &amp; sponsors <small>{orgs.length} profiled</small></h2>
        <p class="xp-sub">Non-country participants with a public, sourced presence at the Expo.</p>
        <div class="xp-grid">
          {orgs.map((l, i) => (
            <a class="xp-panel" href={listingHref(l)} style={`--i:${i}`}>
              <div class="xp-panel__top">
                <span class="xp-panel__code">ORG·{String(i + 1).padStart(2, "0")}</span>
                <span>{l.type}</span>
              </div>
              <h3>{l.name}</h3>
              {l.status ? (
                <span class={`xp-led xp-led--${l.status}`}>
                  <i></i>
                  {STATUS_LABEL[l.status] ?? l.status}
                </span>
              ) : null}
              <p>{firstSentence(l.summary)}</p>
              <div class="xp-panel__foot">
                <span>Updated <b>{fmt(l.updated)}</b></span>
                <span><b>{l.blocks.facts?.length ?? 0}</b> facts</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <section id="countries" class="xp-section">
      <h2 class="xp-h2">Named, not yet profiled <small>{slots.length} slots</small></h2>
      <p class="xp-sub">
        Countries a source has publicly named as participants, without a substantive pavilion
        announcement yet. Each slot becomes a panel the day sourced plans land. The search and
        region selectors above filter these too.
      </p>
      <div class="xp-slots" data-atlas-slots>
        {slots.map((c, i) => (
          <div
            class={`xp-slot${c.host ? " xp-slot--host" : ""}`}
            style={`--i:${i}`}
            data-name={c.name.toLowerCase()}
            data-region={c.region}
          >
            <b>{c.name}</b>
            <small>{c.host ? "Host country" : `${c.region} · named`}</small>
          </div>
        ))}
      </div>
      <div class="xp-empty" data-atlas-empty-slots>No named country matches.</div>
    </section>

    <Note tone="gold">
      <strong>Represent a pavilion or exhibitor?</strong> Each profile can be
      <a href="/for-businesses"> claimed for free</a> — you keep it current yourself, we handle
      the technical side. Profiles are compiled editorially and marked with their sources until
      then.
    </Note>

    <h2 class="xp-h2">More on Expo 2027</h2>
    <div class="c-linkgrid">
      <a class="c-linkcard" href="/expo-2027/tracker">
        <span class="c-linkcard__kicker">Data</span>
        <span class="c-linkcard__title">Participant tracker</span>
        <p>Every publicly named country, confirmation dates and the growth timeline — with sources.</p>
      </a>
      <a class="c-linkcard" href="/expo-2027/corporate-area">
        <span class="c-linkcard__kicker">Companies</span>
        <span class="c-linkcard__title">Corporate &amp; Best Practice Area</span>
        <p>How companies get one of the ~45 corporate pavilions, and who has joined so far.</p>
      </a>
      <a class="c-linkcard" href="/expo-2027">
        <span class="c-linkcard__kicker">Guide</span>
        <span class="c-linkcard__title">The full Expo 2027 guide</span>
        <p>Dates, programme, tickets, getting there — and the rest of Belgrade.</p>
      </a>
    </div>
  </Container>

  <Schema schemas={schemas} />

  <script is:inline>
    // Atlas command bar: search + stage + region filters over the panels and
    // the slots, A–Z / latest sort for the panels, live count, live countdown.
    // Without JS every panel and slot is simply visible.
    (function () {
      "use strict";
      var root = document.querySelector("[data-atlas]");
      var grid = document.querySelector("[data-atlas-grid]");
      var slots = document.querySelector("[data-atlas-slots]");
      if (!root || !grid) return;
      var panels = Array.prototype.slice.call(grid.children);
      var slotEls = slots ? Array.prototype.slice.call(slots.children) : [];
      var search = root.querySelector("[data-atlas-search]");
      var count = root.querySelector("[data-atlas-count]");
      var emptyP = document.querySelector("[data-atlas-empty]");
      var emptyS = document.querySelector("[data-atlas-empty-slots]");
      var state = { q: "", status: "", region: "", sort: "name" };

      function seg(attr, key) {
        var btns = Array.prototype.slice.call(root.querySelectorAll("[" + attr + "]"));
        btns.forEach(function (b) {
          b.addEventListener("click", function () {
            state[key] = b.getAttribute(attr) || "";
            btns.forEach(function (x) { x.classList.toggle("is-on", x === b); });
            apply();
          });
        });
      }
      seg("data-atlas-status", "status");
      seg("data-atlas-region", "region");
      seg("data-atlas-sort", "sort");
      if (search) search.addEventListener("input", function () { state.q = search.value.trim().toLowerCase(); apply(); });

      function match(el, withStatus) {
        var okQ = !state.q || (el.getAttribute("data-name") || "").indexOf(state.q) !== -1;
        var okR = !state.region || el.getAttribute("data-region") === state.region;
        var okS = !withStatus || !state.status || el.getAttribute("data-status") === state.status;
        return okQ && okR && okS;
      }
      function apply() {
        var shownP = 0, shownS = 0;
        panels.forEach(function (el) { var ok = match(el, true); el.hidden = !ok; if (ok) shownP++; });
        slotEls.forEach(function (el) { var ok = !state.status && match(el, false); el.hidden = !ok; if (ok) shownS++; });
        var sorted = panels.slice().sort(function (a, b) {
          if (state.sort === "updated") {
            var d = (b.getAttribute("data-updated") || "").localeCompare(a.getAttribute("data-updated") || "");
            if (d) return d;
          }
          return (a.getAttribute("data-name") || "").localeCompare(b.getAttribute("data-name") || "");
        });
        var frag = document.createDocumentFragment();
        sorted.forEach(function (el, i) { el.style.setProperty("--i", String(i)); frag.appendChild(el); });
        grid.appendChild(frag);
        if (count) count.textContent = shownP + " / " + panels.length + " profiles · " + shownS + " slots";
        if (emptyP) emptyP.classList.toggle("is-on", shownP === 0);
        if (emptyS) emptyS.classList.toggle("is-on", shownS === 0 && !state.status);
      }
      apply();

      var deck = document.querySelector("[data-expo-start]");
      var num = document.querySelector("[data-countdown]");
      if (deck && num) {
        var start = Date.parse(deck.getAttribute("data-expo-start") + "T00:00:00+02:00");
        var tick = function () { num.textContent = String(Math.max(0, Math.ceil((start - Date.now()) / 86400000))); };
        tick();
        setInterval(tick, 60000);
      }
    })();
  </script>
</BaseLayout>
