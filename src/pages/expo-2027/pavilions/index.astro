---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import PageIntro from "../../../components/PageIntro.astro";
import Container from "../../../components/Container.astro";
import SectionHead from "../../../components/SectionHead.astro";
import Grid from "../../../components/Grid.astro";
import Card from "../../../components/Card.astro";
import Note from "../../../components/Note.astro";
import Schema from "../../../components/Schema.astro";
import { pageMetadata } from "../../../lib/metadata";
import { ogImage } from "../../../lib/og";
import { SITE, EXPO, CONFIG } from "../../../lib/site";
import { breadcrumbSchema } from "../../../lib/schemas";
import {
  listingsForLeg,
  listingHref,
  listingsIndexable,
  newestUpdated,
  STATUS_LABEL,
} from "../../../lib/listings";
import { participants, byRegion } from "../../../lib/expo-participants";
import { alternates } from "../../../lib/i18n";

// Pavilion directory hub. 2026-09-06 redesign (mobile-first): profiled
// pavilions as image cards with a status chip and a status filter, other
// organisations as link tiles, and every named country as a chip grouped by
// region (a linked chip = a profile exists) instead of a 140-row table.
// Built-vs-pending mirrors the leg-hub pattern; noindex behind
// programmatic.listingsIndexable.
const PATH = "/expo-2027/pavilions";
const published = listingsForLeg("expo-2027");
const pavilions = published.filter((l) => l.type === "pavilion");
const orgs = published.filter((l) => l.type !== "pavilion");
const bySlugName = new Map(published.map((l) => [(l.shortName ?? l.name).toLowerCase(), l]));
const updated = newestUpdated("expo-2027");
const fmt = (d: string) =>
  new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
const firstSentence = (s: string) => {
  const i = s.indexOf(". ");
  return i > 40 ? s.slice(0, i + 1) : s;
};

// Status facets, in pipeline order, only those present.
const STATUS_ORDER = ["construction", "tender", "announced", "concept-only"];
const statusCounts = STATUS_ORDER.map((k) => ({
  key: k,
  label: STATUS_LABEL[k],
  count: pavilions.filter((p) => p.status === k).length,
})).filter((s) => s.count > 0);

// Countries by region (largest region first), each chip linked when profiled.
const regions = byRegion().map((r) => ({
  ...r,
  countries: participants
    .filter((p) => p.region === r.region)
    .map((p) => ({ name: p.name, host: p.host === true, listing: bySlugName.get(p.name.toLowerCase()) ?? null })),
}));

const meta = pageMetadata({
  title: "Expo 2027 pavilions — announced plans by country",
  description: `National pavilions of Expo 2027 Belgrade: which of the ${participants.length} publicly named countries have announced pavilion plans, themes and designs — ${pavilions.length} profiled and sourced.`,
  path: PATH,
  noindex: !listingsIndexable,
  image: ogImage("pavilions"),
  alternates: alternates(PATH), // hreflang ↔ /de/expo-2027/pavilions (language pilot)
});

const crumbs = [
  { name: CONFIG.chrome.article.breadcrumbRoot, href: "/" },
  { name: EXPO.shortName, href: "/expo-2027" },
  { name: "Pavilions" },
];

const schemas: object[] = [
  breadcrumbSchema([
    { name: CONFIG.chrome.article.breadcrumbRoot, url: SITE.origin },
    { name: EXPO.shortName, url: `${SITE.origin}/expo-2027` },
    { name: "Pavilions", url: `${SITE.origin}${PATH}` },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Expo 2027 Belgrade national pavilions with announced plans",
    itemListElement: published.map((l, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: l.name,
      url: `${SITE.origin}${listingHref(l)}`,
    })),
  },
];

const anchors = [
  { href: "#profiles", label: "Profiled pavilions" },
  ...(orgs.length > 0 ? [{ href: "#organisations", label: "Organisations" }] : []),
  { href: "#countries", label: "All countries" },
];
---

<BaseLayout meta={meta}>
  <Breadcrumbs crumbs={crumbs} />
  <PageIntro
    eyebrow="Expo 2027 · Pavilion directory"
    title="Expo 2027 national pavilions"
    lede={`Pavilion plans for ${EXPO.name} are announced country by country. We profile each one as soon as there's real, sourced substance — theme, design, budget, dates — and keep a place reserved for every named participant.`}
  >
    {updated ? <span>Updated {fmt(updated)}</span> : null}
    <span>{pavilions.length} profiles · {participants.length} named countries</span>
  </PageIntro>

  <nav class="c-subnav" aria-label="On this page">
    <Container>
      <ul>
        {anchors.map((a) => (
          <li><a href={a.href}>{a.label}</a></li>
        ))}
      </ul>
    </Container>
  </nav>

  <Container>
    <div class="c-stats">
      <div class="c-stat">
        <div class="c-stat__num">{pavilions.length}</div>
        <div class="c-stat__label">pavilion profiles with sourced plans</div>
      </div>
      {statusCounts.slice(0, 2).map((s) => (
        <div class="c-stat">
          <div class="c-stat__num">{s.count}</div>
          <div class="c-stat__label">{s.label.toLowerCase()}</div>
        </div>
      ))}
      <div class="c-stat">
        <div class="c-stat__num">{participants.length}</div>
        <div class="c-stat__label">countries publicly named — <a href="/expo-2027/tracker">tracker</a></div>
      </div>
    </div>

    <section id="profiles" class="c-hash-section">
      <SectionHead
        eyebrow="Profiled pavilions"
        title="Countries with announced pavilion plans"
        intro="Each profile lists what is confirmed versus merely reported, with a source on every fact. Filter by where the plan stands."
      />
      <div class="c-filterbar" data-status-controls hidden>
        <button class="c-chip is-active" type="button" data-status-chip="">All ({pavilions.length})</button>
        {statusCounts.map((s) => (
          <button class="c-chip" type="button" data-status-chip={s.key}>{s.label} ({s.count})</button>
        ))}
        <span class="c-filterbar__count" data-status-count aria-live="polite"></span>
      </div>
      <div class="u-stack-md"></div>
      <div class="c-grid" data-pavilion-grid>
        {pavilions.map((l) => (
          <div data-status={l.status ?? ""}>
            <Card
              href={listingHref(l)}
              title={l.name}
              body={firstSentence(l.summary)}
              badge={l.status ? STATUS_LABEL[l.status] ?? l.status : undefined}
              badgeTone={l.status}
              meta={`Updated ${fmt(l.updated)}`}
              shape="wide"
              src={ogImage(`pavilion-${l.slug}`)}
              imgAlt={`${l.name} — Expo 2027 Belgrade`}
              imgPlaceholder={l.shortName ?? l.name}
            />
          </div>
        ))}
      </div>
    </section>

    {orgs.length > 0 && (
      <section id="organisations" class="c-hash-section">
        <div class="u-stack-lg"></div>
        <SectionHead
          eyebrow="Beyond the flags"
          title="Organisations, sponsors & special participants"
          intro="Non-country participants with a public, sourced presence at the Expo."
        />
        <div class="c-linkgrid">
          {orgs.map((l) => (
            <a class="c-linkcard" href={listingHref(l)}>
              <span class="c-linkcard__kicker">{l.type}</span>
              <span class="c-linkcard__title">{l.name}</span>
              <p>{firstSentence(l.summary)}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <section id="countries" class="c-hash-section">
      <div class="u-stack-lg"></div>
      <SectionHead
        eyebrow="All named countries"
        title={`Every publicly named participant, by region`}
        intro="A highlighted country has a pavilion profile. A plain one has been named as a participant, but no substantive pavilion announcement has been sourced yet — chips light up as plans land."
      />
      {regions.map((r) => (
        <>
          <h3 class="c-chiplist__group">
            {r.region} <small>({r.count})</small>
          </h3>
          <ul class="c-chiplist">
            {r.countries.map((c) => (
              <li>
                {c.listing ? (
                  <a href={listingHref(c.listing)}>{c.name}{c.host ? " · host" : ""}</a>
                ) : (
                  <span>{c.name}{c.host ? " · host" : ""}</span>
                )}
              </li>
            ))}
          </ul>
        </>
      ))}
    </section>

    <Note tone="gold">
      <strong>Represent a pavilion or exhibitor?</strong> Each profile can be
      <a href="/for-businesses"> claimed for free</a> — you keep it current yourself, we handle
      the technical side. Profiles are compiled editorially and marked with their sources until
      then.
    </Note>

    <SectionHead title="More on Expo 2027" />
    <div class="c-linkgrid">
      <a class="c-linkcard" href="/expo-2027/tracker">
        <span class="c-linkcard__kicker">Data</span>
        <span class="c-linkcard__title">Participant tracker</span>
        <p>Every publicly named country, confirmation dates and the growth timeline — with sources.</p>
      </a>
      <a class="c-linkcard" href="/expo-2027/corporate-area">
        <span class="c-linkcard__kicker">Companies</span>
        <span class="c-linkcard__title">Corporate &amp; Best Practice Area</span>
        <p>How companies get one of the ~45 corporate pavilions, and who has joined so far.</p>
      </a>
      <a class="c-linkcard" href="/expo-2027">
        <span class="c-linkcard__kicker">Guide</span>
        <span class="c-linkcard__title">The full Expo 2027 guide</span>
        <p>Dates, programme, tickets, getting there — and the rest of Belgrade.</p>
      </a>
    </div>
  </Container>

  <Schema schemas={schemas} />

  <script is:inline>
    // Status filter for the pavilion cards. Controls ship hidden; no-JS users
    // see every card. Same chip pattern as the country directory on /expo-2027.
    (function () {
      var controls = document.querySelector("[data-status-controls]");
      var grid = document.querySelector("[data-pavilion-grid]");
      if (!controls || !grid) return;
      controls.hidden = false;
      var items = Array.prototype.slice.call(grid.children);
      var chips = Array.prototype.slice.call(controls.querySelectorAll("[data-status-chip]"));
      var count = controls.querySelector("[data-status-count]");
      chips.forEach(function (chip) {
        chip.addEventListener("click", function () {
          var want = chip.getAttribute("data-status-chip") || "";
          chips.forEach(function (c) { c.classList.toggle("is-active", c === chip); });
          var shown = 0;
          items.forEach(function (el) {
            var ok = !want || el.getAttribute("data-status") === want;
            el.hidden = !ok;
            if (ok) shown++;
          });
          if (count) count.textContent = want ? shown + " of " + items.length + " shown" : "";
        });
      });
    })();
  </script>
</BaseLayout>
