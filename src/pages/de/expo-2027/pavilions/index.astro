---
// /de/expo-2027/pavilions — German pavilion directory (language pilot). Same
// EXPO ATLAS chrome as the English atlas (globals.css xp-*): ink deck with
// readouts, LED-status panels for the profiles that carry a German block,
// English-only profiles as panels marked EN. Every other named country lives
// in the English atlas (linked), so nothing is hidden from German readers.
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import Container from "../../../../components/Container.astro";
import Note from "../../../../components/Note.astro";
import Schema from "../../../../components/Schema.astro";
import { pageMetadata } from "../../../../lib/metadata";
import { ogImage } from "../../../../lib/og";
import { SITE, CONFIG, EXPO } from "../../../../lib/site";
import { breadcrumbSchema } from "../../../../lib/schemas";
import { listingsForLeg, listingsWithDe, listingHref, listingsIndexable } from "../../../../lib/listings";
import { participants, regionOf, regionCode, STAGE, officialCount } from "../../../../lib/expo-participants";
import { alternates, dePath, DE, fmtDate } from "../../../../lib/i18n";

const LEG = "expo-2027";
const EN_PATH = `/${LEG}/pavilions`;
const PATH = dePath(EN_PATH);
const de = listingsWithDe(LEG);
const deSlugs = new Set(de.map((l) => l.slug));
const englishOnly = listingsForLeg(LEG).filter((l) => !deSlugs.has(l.slug));
const L = DE.listing;
const DAY = 86400000;
const daysToOpen = Math.max(0, Math.ceil((Date.parse(`${EXPO.startDate}T00:00:00+02:00`) - Date.now()) / DAY));
const firstSentence = (s: string) => {
  const i = s.indexOf(". ");
  return i > 40 ? s.slice(0, i + 1) : s;
};
const perRegion = new Map<string, number>();
const panel = (l: (typeof de)[number]) => {
  const region = regionOf(l.shortName) ?? regionOf(l.name);
  const key = region ?? "—";
  const n = (perRegion.get(key) ?? 0) + 1;
  perRegion.set(key, n);
  return { region, code: `${regionCode(region)}·${String(n).padStart(2, "0")}`, stage: l.status ? (STAGE[l.status] ?? 0) : 0 };
};

const meta = pageMetadata({
  title: "Expo 2027 Pavillons – Deutschland, Österreich, Schweiz",
  description: `Die Pavillons der Expo 2027 Belgrad auf Deutsch: die DACH-Länder im Detail, alle weiteren der ${participants.length} namentlich bekannten Teilnehmerländer auf Englisch – quellengeprüft.`,
  path: PATH,
  noindex: !listingsIndexable,
  image: ogImage("pavilions"),
  lang: "de",
  alternates: alternates(EN_PATH),
});

const crumbs = [
  { name: CONFIG.chrome.article.breadcrumbRoot, href: "/de/expo-2027" },
  { name: "Expo 2027", href: "/de/expo-2027" },
  { name: "Pavillons" },
];

const schemas: object[] = [
  breadcrumbSchema([
    { name: CONFIG.chrome.article.breadcrumbRoot, url: `${SITE.origin}/de/expo-2027` },
    { name: "Expo 2027", url: `${SITE.origin}/de/expo-2027` },
    { name: "Pavillons", url: `${SITE.origin}${PATH}` },
  ]),
];
---

<BaseLayout meta={meta}>
  <Breadcrumbs crumbs={crumbs} />

  <section class="xp-deck">
    <Container>
      <span class="xp-deck__eyebrow">Expo 2027 · Pavillon-Atlas</span>
      <h1>Die Pavillons der Expo 2027 <em>auf Deutsch</em></h1>
      <p class="xp-deck__lede">
        Welche Länder haben Pläne für ihren Pavillon veröffentlicht – mit welchem Motto, welchem Team,
        welchem Budget? Die Profile der deutschsprachigen Länder hier auf Deutsch; alle weiteren
        Profile auf Englisch. Jede Angabe trägt ihre Quelle.
      </p>
      <div class="xp-readouts">
        <div class="xp-readout">
          <div class="xp-readout__k">Eröffnung</div>
          <div class="xp-readout__v">{daysToOpen}<small>Tage</small></div>
        </div>
        <div class="xp-readout">
          <div class="xp-readout__k">Profile auf Deutsch</div>
          <div class="xp-readout__v">{de.length}<small>DACH</small></div>
        </div>
        <div class="xp-readout">
          <div class="xp-readout__k">Weitere Profile</div>
          <div class="xp-readout__v">{englishOnly.length}<small>EN</small></div>
        </div>
        <div class="xp-readout">
          <div class="xp-readout__k">Länder benannt</div>
          <div class="xp-readout__v">{participants.length}<small>von {officialCount}</small></div>
        </div>
      </div>
    </Container>
  </section>

  <Container>
    <section class="xp-section">
      <h2 class="xp-h2">Deutschland, Österreich, Schweiz <small>{de.length} Profile</small></h2>
      <p class="xp-sub">Quellengeprüfte Profile der DACH-Pavillons: Motto, Team, Budget, Größe – und was noch offen ist.</p>
      <div class="xp-grid">
        {de.map((l, i) => {
          const p = panel(l);
          return (
            <a class="xp-panel" href={dePath(listingHref(l))} style={`--i:${i}`}>
              <div class="xp-panel__top">
                <span class="xp-panel__code">{p.code}</span>
                <span>{p.region ?? "Pavillon"}</span>
              </div>
              <h3>{l.i18n?.de?.name ?? l.name}</h3>
              {l.status ? (
                <span class={`xp-led xp-led--${l.status}`}><i></i>{L.status[l.status] ?? l.status}</span>
              ) : null}
              <div class="xp-track" data-stage={p.stage} aria-label={`Stufe ${p.stage} von 4`}>
                <i></i><i></i><i></i><i></i>
              </div>
              <p>{firstSentence(l.i18n?.de?.summary ?? l.summary)}</p>
              <div class="xp-panel__foot">
                <span>{DE.updated} <b>{fmtDate(l.updated, "de")}</b></span>
                <span><b>{l.blocks.facts?.length ?? 0}</b> Fakten</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    {englishOnly.length > 0 ? (
      <section class="xp-section">
        <h2 class="xp-h2">Weitere Pavillon-Profile <small>{englishOnly.length} · Englisch</small></h2>
        <p class="xp-sub">Länder und Organisationen mit veröffentlichten Plänen – bisher nur in der englischen Ausgabe.</p>
        <div class="xp-grid">
          {englishOnly.map((l, i) => {
            const p = panel(l);
            return (
              <a class="xp-panel" href={listingHref(l)} hreflang="en" style={`--i:${i}`}>
                <div class="xp-panel__top">
                  <span class="xp-panel__code">{p.code}</span>
                  <span>EN</span>
                </div>
                <h3>{l.name}</h3>
                {l.status ? (
                  <span class={`xp-led xp-led--${l.status}`}><i></i>{L.status[l.status] ?? l.status}</span>
                ) : null}
                <div class="xp-track" data-stage={p.stage} aria-label={`Stufe ${p.stage} von 4`}>
                  <i></i><i></i><i></i><i></i>
                </div>
                <div class="xp-panel__foot">
                  <span>{DE.updated} <b>{fmtDate(l.updated, "de")}</b></span>
                  <span><b>{l.blocks.facts?.length ?? 0}</b> Fakten</span>
                </div>
              </a>
            );
          })}
        </div>
        <Note>
          Das vollständige Verzeichnis aller {participants.length} namentlich bekannten Teilnehmerländer –
          auch derer ohne veröffentlichte Pavillon-Pläne – steht im englischen{" "}
          <a href={EN_PATH} hreflang="en">Pavillon-Atlas (EN)</a>.
        </Note>
      </section>
    ) : null}
  </Container>

  <Schema schemas={schemas} />
</BaseLayout>
