---
// Slovak mirror of an Expo article (Slovak pilot, lib/i18n.ts): the `sk`
// content collection holds one file per translated English slug; the layout
// is the same ArticleLayout with lang="sk".
import ArticleLayout from "../../../layouts/ArticleLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const sk = await getCollection("sk");
  return sk
    .filter((entry) => entry.data.leg === "expo-2027")
    .map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
---
<ArticleLayout entry={entry} lang="sk" />
