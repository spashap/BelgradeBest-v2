---
// Czech mirror of an Expo article (Czech pilot, lib/i18n.ts): the `cs`
// content collection holds one file per translated English slug; the layout
// is the same ArticleLayout with lang="cs".
import ArticleLayout from "../../../layouts/ArticleLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const cs = await getCollection("cs");
  return cs
    .filter((entry) => entry.data.leg === "expo-2027")
    .map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
---
<ArticleLayout entry={entry} lang="cs" />
